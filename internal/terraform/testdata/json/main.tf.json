{
  "variable": { "n": { "default": 2 } },
  "resource": {
    "aws_instance": {
      "web": {
        "count": "${var.n}",
        "instance_type": "t3.micro",
        "root_block_device": [{ "volume_size": 20 }],
        "depends_on": ["aws_vpc.main"]
      }
    },
    "aws_vpc": { "main": { "cidr_block": "10.0.0.0/16" } }
  }
}
